FROM python:3.11-slim

# Clone MLPerf Inference reference scripts — loadgen is built from source
RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential cmake \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch v5.0 \
    https://github.com/mlcommons/inference.git /mlperf_inference

# Build and install mlperf_loadgen from source
RUN cd /mlperf_inference/loadgen && pip install --no-cache-dir .

# Client runtime deps — no torch, no vLLM.
# SUT_VLLM_http_client.py is mounted at runtime and has no torch/vLLM imports.
RUN pip install --no-cache-dir \
    transformers==4.46.2 \
    sentencepiece==0.2.0 \
    requests==2.31.0 \
    numpy \
    tqdm && \
    pip install --no-cache-dir --no-deps tokenizers==0.20.3

WORKDIR /mlperf_inference/language/llama3.1-405b
