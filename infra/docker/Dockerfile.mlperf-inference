FROM nvcr.io/nvidia/pytorch:24.07-py3
WORKDIR /workspace

# Install vLLM, LoadGen, and inference dependencies
RUN pip install --no-cache-dir \
    vllm==0.6.3 \
    transformers==4.46.2 \
    nltk==3.8.1 \
    evaluate==0.4.0 \
    rouge-score==0.1.2 \
    accelerate==0.21.0 \
    sentencepiece==0.2.0 \
    absl-py==1.4.0 \
    huggingface_hub \
    mlperf-loadgen

# Clone MLPerf Inference reference scripts (pinned to v5.0 tag)
RUN git clone --depth 1 --branch v5.0 \
    https://github.com/mlcommons/inference.git /mlperf_inference

WORKDIR /mlperf_inference/language/llama3.1-8b
