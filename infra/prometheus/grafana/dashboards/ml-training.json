{
  "title": "ML Training Infrastructure",
  "uid": "ml-training",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Agent Health",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 3 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "up{job=\"ml_training_nodes\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Ethernet — Bytes/s",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 3, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(ml_net_interface_bytes_total{transport=\"ethernet\"}[5m])",
          "legendFormat": "{{instance}} {{interface}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 1 }
        }
      }
    },
    {
      "id": 3,
      "title": "Ethernet — Packets/s",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 3, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(ml_net_interface_packets_total{transport=\"ethernet\"}[5m])",
          "legendFormat": "{{instance}} {{interface}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": { "lineWidth": 1 }
        }
      }
    },
    {
      "id": 4,
      "title": "InfiniBand — Data Bytes/s",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 11, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(ml_ib_port_data_bytes_total[5m])",
          "legendFormat": "{{instance}} {{device}} port{{port}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 1 }
        }
      }
    },
    {
      "id": 5,
      "title": "InfiniBand — Errors/s",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 11, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(ml_ib_port_errors_total[5m])",
          "legendFormat": "{{instance}} {{device}} port{{port}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "eps",
          "custom": { "lineWidth": 1 }
        }
      }
    },
    {
      "id": 6,
      "title": "NVLink — Bytes/s per GPU per Link",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(ml_nvlink_bytes_total[5m])",
          "legendFormat": "{{instance}} gpu{{gpu_index}} link{{link_index}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 1 }
        }
      }
    }
  ]
}
